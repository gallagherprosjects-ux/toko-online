PORT=4000
# MongoDB lokal, atau connection string MongoDB Atlas (mongodb+srv://...)
MONGODB_URI=mongodb://127.0.0.1:27017/toko_online
# Kunci penanda tangan JWT. Wajib diganti dengan string acak panjang di production.
JWT_SECRET=isi-dengan-string-acak-panjang
JWT_EXPIRES=2h
# Email yang boleh mengelola produk (pisahkan koma). Kosong = semua pengguna yang login boleh.
ADMIN_EMAILS=
# boleh lebih dari satu, pisahkan dengan koma
FRONTEND_URL=http://localhost:5173
